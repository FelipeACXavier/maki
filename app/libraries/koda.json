        {
          "type": "Task",
          "body": {
            "shape": "Rectangle",
            "textColor": "#FFFFFF",
            "backgroundColor": "#202020",
            "borderColor": "#FFFFFF",
            "width": 250,
            "height": 250,
            "z-index": -2
          },
          "help": {
            "message": "Represents a Task in a single system. Tasks must be populated with Capabilities."
          },
          "properties": [
            {
              "id": "name",
              "type": "string",
              "default": {
                "kind": "string",
                "value": "Task"
              },
              "info": "The name of the block"
            },
            {
              "id": "color",
              "type": "void",
              "control": "color",
              "default": {
                "kind": "string",
                "value": "#202020"
              },
              "info": "The color of the block"
            }
          ],
          "controls": [
            {
              "id": "Add event",
              "type": "add event"
            }
          ],
          "events": [
            {
              "id": "start",
              "type": "trigger",
              "returnType": "void",
              "modifiable": true,
              "linksTo": 0,
              "info": "Called to start the task"
            },
            {
              "id": "abort",
              "type": "abort",
              "returnType": "void",
              "modifiable": false,
              "linksTo": 0,
              "info": "Called to abort the task when it is running"
            },
            {
              "id": "done",
              "type": "return",
              "returnType": "void",
              "modifiable": false,
              "linksTo": 0,
              "info": "Emitted when the task is completed successfully"
            },
            {
              "id": "failed",
              "type": "error",
              "returnType": "void",
              "modifiable": false,
              "linksTo": 0,
              "info": "Emitted when the task is completed unsuccessfully"
            }
          ]
        }
      ]
    },

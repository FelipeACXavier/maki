        {
          "type": "Task",
          "body": {
            "shape": "rounded rectangle",
            "textColor": "#000000",
            "backgroundColor": "#FFFFFF",
            "borderColor": "#000000",
            "width": 324,
            "height": 300,
            "borderRadius": 28,
            "z-index": -2
          },
          "help": {
            "message": "Represents a Task in a single system. Tasks must be populated with Capabilities."
          },
          "properties": [
            {
              "id": "name",
              "type": "string",
              "default": "Task",
              "info": "The name of the block"
            },
            {
              "id": "color",
              "type": "color",
              "default": "#FFFFFF",
              "info": "The color of the block"
            }
          ],
          "controls": [
            {
              "id": "Add event",
              "type": "add event"
            },
            {
              "id": "Add state",
              "type": "add state"
            }
          ],
          "events": [
            {
              "id": "start",
              "type": "trigger",
              "returnType": "void",
              "modifiable": true,
              "linksTo": 0,
              "info": "Called to start the task"
            },
            {
              "id": "abort",
              "type": "abort",
              "returnType": "void",
              "modifiable": false,
              "linksTo": 0,
              "info": "Called to abort the task when it is running"
            },
            {
              "id": "done",
              "type": "return",
              "returnType": "void",
              "modifiable": false,
              "linksTo": 0,
              "info": "Emitted when the task is completed successfully"
            },
            {
              "id": "failed",
              "type": "error",
              "returnType": "void",
              "modifiable": false,
              "linksTo": 0,
              "info": "Emitted when the task is completed unsuccessfully"
            }
          ]
        }
      ]
    },

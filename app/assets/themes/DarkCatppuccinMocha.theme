# Dark theme: Catppuccin Mocha-ish
background: #1E1E2E
foreground: #CDD6F4
faded_foreground: #A6ADC8
highlight: #89B4FA
selection_fg: #1E1E2E
selection_bg: #CDD6F4
border_radius: 8
icon_size: 16

info_color: #74C7EC
error_color: #F38BA8
warning_color: #F9E2AF

notification_width: 360
min_notification_height: 56
max_notification_height: 180
notification_left_margin: 16
notification_top_margin: 16
notification_between_margin: 10

scrollbar_handle: #45475A
scrollbar_handle_hover: #585B70

button_size: 30

input_bg: #181825
input_border: #313244
input_focus_border: #89B4FA
combobox_bg: #313244
control_border: #45475A

combobox_hover_border: #74C7EC
arrow_icon_up: :/icons/arrow-up-dark.svg
arrow_icon_down: :/icons/arrow-down-dark.svg
arrow_icon_right: :/icons/arrow-right-dark.svg

uncheck_icon: :/icons/uncheck-dark.svg
check_icon: :/icons/check-dark.svg
limit_icon: :/icons/limit-dark.svg

tab_bg: #313244
tab_border_color: #45475A
tab_selected_bg: #1E1E2E

menu_bg: #1E1E2E
menu_border: #45475A

toolbar_bg: #1B1B2B
toolbar_border: #45475A
toolbutton_hover_bg: #313244
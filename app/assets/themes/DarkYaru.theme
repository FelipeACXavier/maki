# Yaru Dark (Ubuntu orange)
background: #2C2C2C
foreground: #F2F2F2
faded_foreground: #B3B3B3
highlight: #E95420
selection_fg: #FFFFFF
selection_bg: #E95420
border_radius: 8
icon_size: 16
eyedropper_icon: :/icons/eye-dropper-dark.svg

# General Colors
info_color: #4AA3FF
error_color: #FF5C5C
warning_color: #F6A821

# Notification
notification_width: 360
min_notification_height: 56
max_notification_height: 180

# Scroll bar
scrollbar_handle: #555555
scrollbar_handle_hover: #666666

# Button
button_size: 30

# General input
input_bg: #1F1F1F
input_border: #444444
input_focus_border: #E95420
combobox_bg: #3A3A3A
control_border: #555555

# Combo box
combobox_hover_border: #E95420
arrow_icon_up: :/icons/arrow-up-dark.svg
arrow_icon_down: :/icons/arrow-down-dark.svg
arrow_icon_right: :/icons/arrow-right-dark.svg

# Checkbox
uncheck_icon: :/icons/uncheck-dark.svg
check_icon: :/icons/check-dark.svg
limit_icon: :/icons/limit-dark.svg

# Tabs (unchanged structure)
tab_bg: #3A3A3A
tab_border_color: #444444
tab_selected_bg: #2C2C2C

# Menu
menu_bg: #2C2C2C
menu_border: #444444

# Toolbar
toolbar_bg: #303030
toolbar_border: #444444
toolbutton_hover_bg: #3A3A3A
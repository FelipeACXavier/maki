# Light theme: Cool Mint
background: #F3FBF8
foreground: #0F172A
faded_foreground: #4B5563
highlight: #10B981
selection_fg: #F3FBF8
selection_bg: #10B981
border_radius: 8
icon_size: 16

info_color: #0EA5E9
error_color: #EF4444
warning_color: #F59E0B

notification_width: 360
min_notification_height: 56
max_notification_height: 180
notification_left_margin: 16
notification_top_margin: 16
notification_between_margin: 10

scrollbar_handle: #CFEDE2
scrollbar_handle_hover: #BFE2D6

button_size: 30

input_bg: #FFFFFF
input_border: #CFEDE2
input_focus_border: #10B981
combobox_bg: #E6F6F0
control_border: #CFEDE2

combobox_hover_border: #10B981
arrow_icon_up: :/icons/arrow-up.svg
arrow_icon_down: :/icons/arrow-down.svg
arrow_icon_right: :/icons/arrow-right.svg

uncheck_icon: :/icons/uncheck.svg
check_icon: :/icons/check.svg
limit_icon: :/icons/limit.svg

tab_bg: #E6F6F0
tab_border_color: #CFEDE2
tab_selected_bg: #FFFFFF

menu_bg: #F3FBF8
menu_border: #CFEDE2

toolbar_bg: #EAF8F3
toolbar_border: #CFEDE2
toolbutton_hover_bg: #DFF3EA
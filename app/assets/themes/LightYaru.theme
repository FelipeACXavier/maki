# Yaru Light (Ubuntu orange)
background: #FAFAFA
foreground: #111111
faded_foreground: #5A5A5A
highlight: #E95420
selection_fg: #FFFFFF
selection_bg: #E95420
border_radius: 8
icon_size: 16

# General Colors
info_color: #2C7EDB
error_color: #D64541
warning_color: #F6A821

# Notification
notification_width: 360
min_notification_height: 56
max_notification_height: 180
notification_left_margin: 16
notification_top_margin: 16
notification_between_margin: 10

# Scroll bar
scrollbar_handle: #C9C9C9
scrollbar_handle_hover: #B5B5B5

# Button
button_size: 30

# General input
input_bg: #FFFFFF
input_border: #CFCFCF
input_focus_border: #E95420
combobox_bg: #F2F2F2
control_border: #CFCFCF

# Combo box
combobox_hover_border: #E95420
arrow_icon_up: :/icons/arrow-up-light.svg
arrow_icon_down: :/icons/arrow-down-light.svg
arrow_icon_right: :/icons/arrow-right-light.svg

# Checkbox
uncheck_icon: :/icons/uncheck-light.svg
check_icon: :/icons/check-light.svg
limit_icon: :/icons/limit-light.svg

# Tabs (unchanged structure)
tab_bg: #F2F2F2
tab_border_color: #CFCFCF
tab_selected_bg: #FFFFFF

# Menu
menu_bg: #FAFAFA
menu_border: #CFCFCF

# Toolbar
toolbar_bg: #F2F2F2
toolbar_border: #CFCFCF
toolbutton_hover_bg: #EDEDED
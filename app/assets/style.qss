/* ===============================
   QSPLITER
   =============================== */

QSplitter::handle:hover {
  /* border: 1px solid @selection_fg; */
  background: @selection_bg;
}

QSplitter::handle:horizontal {
  width: 5px;
}

QSplitter::handle:vertical {
  height: 5px;
}

/* ===============================
   QFrame
   =============================== */

QFrame#HLine {
  color: @foreground;
  background: @foreground;
}

/* ===============================
   QLISTWIDGET
   =============================== */
QListWidget#SettingsList {
  padding: 5px 1px;
  margin-right: 0px;
  padding-right: 0px;
}

QListWidget#SettingsList::item {
  padding: 5px;
  border-bottom: 2px solid @background;
}

QListWidget#SettingsList::item:selected {
  color: @foreground;
  background: @background;

  /* padding-left: 2px; */
  /* border-left: 2px solid @selection_bg; */
  border-bottom: 2px solid @selection_bg;
}

/* ===============================
   NOTIFICATIONWIDGET
   =============================== */
NotificationWidget {
  color: @foreground;
  background-color: @background;

  min-width: 300px;
  max-width: @notification_width;
  min-height: @min_notification_height;
  max-height: @max_notification_height;

  padding: 0px;
  font-size: 16px;

  border: 2px solid @foreground;
  border-radius: @border_radius;
}

QPushButton#FlatButton {
  max-width: 16px;
  max-height: 16px;
  padding: 0;

  background: transparent;
  border: none;
}

QPushButton#FlatButton:hover {
  border: 1px solid @foreground;
}

QLabel#NotificationTitle {
  background: transparent;
  font-size: 20px;
  padding: 0;
}

QWidget#NotificationHeader {
  height: 36px;

  color: @foreground;
  background-color: @background;
  font: bold 20px;

  border-top-left-radius: @border_radius;
  border-top-right-radius: @border_radius;
  border-bottom: 2px solid @foreground;
}

QWidget#NotificationBody {
  border-bottom-left-radius: @border_radius;
  border-bottom-right-radius: @border_radius;
}

NotificationWidget[level="info"] {
  border: 2px solid @info_color;
}

QWidget#NotificationHeader[level="info"] {
  border-bottom: px solid @info_color;
}

NotificationWidget[level="error"] {
  border: 2px solid @error_color;
}

QWidget#NotificationHeader[level="error"] {
  border-bottom: 2px solid @error_color;
}

NotificationWidget[level="warning"] {
  border: 2px solid @warning_color;
}

QWidget#NotificationHeader[level="warning"] {
  border-bottom: 2px solid @warning_color;
}

/* ===============================
   QTABLEVIEW
   =============================== */
QTableView {
  color: @foreground;
  background: @input_bg;

  border: 1px solid @control_border;
  border-bottom-left-radius: @border_radius;
  border-bottom-right-radius: @border_radius;
}

QTableView QHeaderView::section {
  color: @foreground;
  background-color: @background;

  padding: 2px 5px;

  border: none;
  border-bottom: 1px solid @control_border;
}

QTableView QHeaderView::section:first {
  border-top-left-radius: @border_radius;
}

QTableView QHeaderView::section:last {
  border-top-right-radius: @border_radius;
}

QTableView::item {
  padding: 2px 5px;
  border-bottom: 1px solid @control_border;
}

QTableView::item:hover {
  border-bottom: 1px solid @selection_bg;

}
QTableView::item:selected {
  color: @selection_fg;
  background-color: @selection_bg;
}

QTableView::item:focus {
  outline: none;
}

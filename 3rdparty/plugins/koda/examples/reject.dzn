import iaction.dzn;

import ../sequence.dzn;
import ../abort_handler.dzn;

component creject {
  provides iaction api;

  requires iaction arm;
  requires iaction ticket;
  requires iaction handler;

  system {
    sequence s0;
    cabort_handler abort_handler;

    api <=> s0.api;

    s0.action1 <=> abort_handler.api;
    s0.action2 <=> ticket;

    abort_handler.action <=> arm;
    abort_handler.handler_action <=> handler;
  }
}
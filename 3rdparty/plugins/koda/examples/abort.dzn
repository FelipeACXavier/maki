import iaction.dzn;

import ../sequence.dzn;

component cabort {
  provides iaction api;

  requires iaction drive;
  requires iaction image;
  requires iaction arm;

  system {
    sequence s0;
    sequence s1;

    api <=> s0.api;
    s0.action1 <=> drive;
    s0.action2 <=> s1.api;

    s1.action1 <=> image;
    s1.action2 <=> arm;
  }
}
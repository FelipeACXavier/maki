import iaction.dzn;
import ialarm.dzn;

import abort.dzn;
import reject.dzn;

// import action_arbiter_2.dzn;

// Capabilities
import image.dzn;
import drive.dzn;
import ticket.dzn;

component Task {
  provides iaction api;

  requires iaction arm1;
  requires iaction arm2;

  system {
    cabort abort_flow;
    creject reject_flow;

    // action_arbiter_2 arm_abrtitrer;

    cimage image;
    cdrive drive;
    cticket ticket;

    api <=> reject_flow.api;
    reject_flow.handler <=> abort_flow.api;

    // Capabilities
    drive.stop <=> abort_flow.drive;
    image.stop <=> abort_flow.image;
    // arm <=> abort_flow.arm;
    reject_flow.ticket <=> ticket.create;

    // Shared capabilities
    // arm <=> arm_abrtitrer.resource;
    // arm_abrtitrer.client1 <=> abort_flow.arm;
    // arm_abrtitrer.client2 <=> reject_flow.arm;
    arm1 <=> abort_flow.arm;
    arm2 <=> reject_flow.arm;
  }
}
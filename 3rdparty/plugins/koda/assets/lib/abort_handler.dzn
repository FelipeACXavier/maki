import types.dzn;
import iaction.dzn;
import isignal.dzn;

component cabort_handler {
  provides iaction api;

  requires iaction action;
  requires iaction handler;

  behaviour {
    enum State { State0, State1, State2, Error };
    State state = State.State0;

    [state.State0] {
      on api.trigger(): {
        Result res1 = action.trigger();
        if (res1.Success)
          state = State.State1;
        else if (res1.Failure)
          state = State.Error;

        reply(res1);
      }

      // on api.abort(): { reply(Result.Success); }
    }

    [state.State1] {
      on action.failure(): {
        api.failure();
        state = State.Error;
      }

      on action.success(): {
        api.success();
        state = State.State0;
      }

      on api.abort(): {
        Result aborted = action.abort();
        if (aborted.Success) {
          Result handled = handler.trigger();
          if (handled.Success) {
            state = State.State2;
            reply(Result.Running);
          } else if (handled.Failure) {
            state = State.Error;
            reply(handled);
          } else {
            state = State.State0;
            reply(Result.Success);
          }
        } else if (aborted.Failure) {
          state = State.Error;
          reply(aborted);
        } else {
          reply (aborted);
        }
      }
    }

    [state.State2] {
      on handler.success(): {
        api.success();
        state = State.State0;
      }

      on handler.failure(): {
        api.failure();
        state = State.Error;
      }

      on api.abort(): {
        Result res = handler.abort();
        if (res.Success)
          state = State.State0;
        else if (res.Failure)
          state = State.Error;

        reply(res);
      }

      // TODO(felaze): Is this correct?
      on action.success(): {}
      on action.failure(): {}
    }

    [state.Error] {
      on api.reset(): {
        Result ret1 = Result.Success;
        Result ret2 = Result.Success;

        if (action.state.Error) {
          ret1 = action.reset();
        }

        if (handler.state.Error) {
          ret2 = handler.reset();
        }

        if (ret1.Success && ret2.Success) {
          state = State.State0;
          reply(Result.Success);
        } else {
          reply(Result.Failure);
        }
      }

      on api.abort(): { reply(Result.Error); }

      on action.success(): {}
      on action.failure(): {}
      on handler.success(): {}
      on handler.failure(): {}
    }
  }
}

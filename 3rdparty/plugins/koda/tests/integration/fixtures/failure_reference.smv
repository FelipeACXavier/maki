-- KODA nuXmv semantic reference model
-- Numeric interface shared with the existing reference suite.
MODULE main

DEFINE
  RESULT_NONE    := 0;
  RESULT_SUCCESS := 1;
  RESULT_FAILURE := 2;
  RESULT_RUNNING := 3;
  RESULT_ERROR   := 4;
  RESULT_DONE    := 5;

  CMD_NONE       := 0;
  CMD_TRIGGER    := 1;
  CMD_ABORT      := 2;
  CMD_RESET      := 3;

  EVENT_NONE     := 0;
  EVENT_SUCCESS  := 1;
  EVENT_FAILURE  := 2;
  EVENT_ABORTED  := 3;

IVAR
  command : 0..3;

VAR
  state : {Idle, Error};

DEFINE
  reply :=
    case
      state = Idle  & command = CMD_TRIGGER : RESULT_FAILURE;
      state = Error & command = CMD_RESET   : RESULT_SUCCESS;
      state = Error & command = CMD_ABORT   : RESULT_ERROR;
      TRUE : RESULT_NONE;
    esac;

  outcome := EVENT_NONE;

INIT state = Idle;

TRANS
  (state = Idle  -> command = CMD_NONE | command = CMD_TRIGGER) &
  (state = Error -> command = CMD_NONE | command = CMD_RESET | command = CMD_ABORT);

ASSIGN
  next(state) :=
    case
      state = Idle  & command = CMD_TRIGGER : Error;
      state = Error & command = CMD_RESET   : Idle;
      TRUE : state;
    esac;

LTLSPEC NAME trigger_always_fails :=
  G ((state = Idle & command = CMD_TRIGGER) ->
     (reply = RESULT_FAILURE & X state = Error));

LTLSPEC NAME reset_recovers :=
  G ((state = Error & command = CMD_RESET) ->
     (reply = RESULT_SUCCESS & X state = Idle));

LTLSPEC NAME abort_in_error_reports_error :=
  G ((state = Error & command = CMD_ABORT) -> reply = RESULT_ERROR);

LTLSPEC NAME failure_never_emits_async_outcome :=
  G (outcome = EVENT_NONE);

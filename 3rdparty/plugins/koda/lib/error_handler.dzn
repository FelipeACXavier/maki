import types.dzn;
import iaction.dzn;

component cerror_handler {
  provides iaction api;

  requires iaction action;
  requires iaction handler;

  behaviour {
    enum State { Idle, Action1, Action2, Error };
    State state = State.Idle;

    [state.Idle] {
      on api.trigger(): {
        Result res1 = action.trigger();
        if (res1.Success)
          state = State.Action1;
        else if (res1.Failure)
          state = State.Error;

        reply(res1);
      }

      // on api.abort(): { reply(Result.Success); }
    }

    [state.Action1] {
      on action.failure(): {
        // Does this make sense? Shouldn't the error handler keep the error and still do something?
        Result reset = action.reset();
        if (reset.Success) {
          Result res = handler.trigger();
          if (res.Success) {
            state = State.Action2;
          } else if (res.Done) {
            api.success();
            state = State.Idle;
          } else {
            api.failure();
            state = State.Error;
          }
        } else {
          api.failure();
          state = State.Error;
        }
      }

      on action.success(): {
        api.success();
        state = State.Idle;
      }

      on api.abort(): {
        Result res = action.abort();
        if (res.Success)
          state = State.Idle;
        else if (res.Failure)
          state = State.Error;

        reply(res);
      }
    }

    [state.Action2] {
      on handler.success(): {
        api.success();
        state = State.Idle;
      }

      on handler.failure(): {
        api.failure();
        state = State.Error;
      }

      on api.abort(): {
        Result res = handler.abort();
        if (res.Success)
          state = State.Idle;
        else if (res.Failure)
          state = State.Error;

        reply(res);
      }
    }

    [state.Error] {
      on api.reset(): {
        Result ret1 = Result.Success;
        Result ret2 = Result.Success;

        if (action.state.Error) {
          ret1 = action.reset();
        }

        if (handler.state.Error) {
          ret2 = handler.reset();
        }

        if (ret1.Success && ret2.Success) {
          state = State.Idle;
          reply(Result.Success);
        } else {
          reply(Result.Failure);
        }
      }

      on api.abort(): { reply(Result.Error); }
    }
  }
}

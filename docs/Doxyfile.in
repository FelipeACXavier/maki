OUTPUT_DIRECTORY       = @CMAKE_SOURCE_DIR@/docs
INPUT                  = @CMAKE_SOURCE_DIR@/app
RECURSIVE              = YES

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO
GENERATE_RTF           = NO

EXTRACT_PRIVATE        = YES
HIDE_UNDOC_MEMBERS     = YES
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_COLORSTYLE        = LIGHT
HTML_EXTRA_STYLESHEET  = \
	@CMAKE_SOURCE_DIR@/3rdparty/doxygen-awesome-css/doxygen-awesome.css \
	@CMAKE_SOURCE_DIR@/3rdparty/doxygen-awesome-css/doxygen-awesome-sidebar-only.css

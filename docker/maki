FROM ubuntu:24.04 AS builder

# -----------------------------------------------------------------------------------------------------------
# Arguments
ARG QT_VERSION=6.8.3
ARG NODE_VERSION=23.8.0
ARG NVM_VERSION=v0.40.2
ARG USERNAME=ubuntu
ARG HOME=/home/${USERNAME}
ARG TOOLCHAIN_FILE=toolchain-mingw64.cmake

# -----------------------------------------------------------------------------------------------------------
# Essential packages
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
  build-essential \
  cmake \
  git \
  ca-certificates \
  wget \
  ninja-build \
  python3.12 \
  python3-pip \
  python3-html5lib \
  python3.12-venv \
  g++-13 \
  ccache \
  libasio-dev \
  libgl1-mesa-dri \
  libgl1-mesa-dev \
  libx11-dev libx11-xcb-dev libxrender-dev libxi-dev \
  libxcb1 libx11-xcb1 '^libxcb.*-dev' \
  libxcb-cursor0 \
  libxkbcommon-x11-0 libxkbcommon-dev libxkbcommon-x11-dev \
  pkg-config \
  locales \
  language-pack-en-base language-pack-en \
  language-pack-nl-base language-pack-nl \
  fontconfig \
  fonts-dejavu-core \
  libfreetype6-dev libfontconfig1-dev libharfbuzz-dev \
  && rm -rf /var/lib/apt/lists/*

# RUN useradd -ms /bin/bash ${USERNAME}

# -----------------------------------------------------------------------------------------------------------
# Make sure the fonts are loaded
RUN fc-cache -f

# Set the locale
RUN git clone https://github.com/PanderMusubi/locale-en-nl.git
RUN cd ./locale-en-nl && ./add.sh

ENV LC_ALL=en_NL.UTF-8
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US.UTF-8

# Make sure we are signed in as ubuntu
USER ${USERNAME}
WORKDIR ${HOME}

# Let's install node, just in case...
RUN wget -O - https://raw.githubusercontent.com/nvm-sh/nvm/${NVM_VERSION}/install.sh | bash
ENV NVM_DIR=${HOME}/.nvm
RUN bash -c "source $NVM_DIR/nvm.sh && nvm install $NODE_VERSION"
RUN bash -c "source $NVM_DIR/nvm.sh && npm i -D wrangler@latest"

# -----------------------------------------------------------------------------------------------------------
# We now need to install qt
USER ${USERNAME}
RUN python3 -m venv env
RUN ${HOME}/env/bin/pip install --no-cache-dir aqtinstall

RUN mkdir -p ${HOME}/Qt && \
    ${HOME}/env/bin/python3 -m aqt install-qt \
      linux \
      desktop \
      "${QT_VERSION}" \
      linux_gcc_64 \
      -m qt5compat qtwebchannel qtwebsockets \
      -O ${HOME}/Qt

# Install the wasm version as well
RUN mkdir -p ${HOME}/Qt && \
    ${HOME}/env/bin/python3 -m aqt install-qt \
      all_os \
      wasm \
      "${QT_VERSION}" \
      wasm_multithread \
      -m qt5compat qtwebchannel qtwebsockets \
      -O ${HOME}/Qt

# Patch the broken include in this specific QT installation
ENV QT_ROOT=${HOME}/Qt/${QT_VERSION}
RUN python3 - <<'PY'
import os
from pathlib import Path

qt_root = Path(os.environ["QT_ROOT"])
file = qt_root / "wasm_multithread/lib/cmake/Qt6Core/Qt6WasmMacros.cmake"
text = file.read_text()

old = """function(_qt_internal_wasm_add_target_helpers target)

    _qt_test_emscripten_version()
"""

new = """function(_qt_internal_wasm_add_target_helpers target)
    include(QtPublicWasmToolchainHelpers OPTIONAL)
    _qt_test_emscripten_version()
"""

if new not in text:
    if old not in text:
        raise SystemExit("Qt6WasmMacros.cmake patch target not found")
    file.write_text(text.replace(old, new, 1))
    print("Patched Qt6WasmMacros.cmake")
else:
    print("Qt6WasmMacros.cmake already patched")
PY

# -----------------------------------------------------------------------------------------------------------\
# Install extra packages
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
  zip \
  unzip \
  gdb \
  libgl1-mesa-dev \
  libgles2-mesa-dev \
  mesa-common-dev \
  libnss3-dev \
  libglib2.0-dev \
  libharfbuzz-dev \
  libudev-dev \
  libpng-dev \
  libtiff-dev \
  libicu-dev \
  libopus-dev \
  libvpx-dev \
  libavutil-dev \
  libavcodec-dev \
  libavformat-dev \
  libswresample-dev \
  libswscale-dev \
  libre2-dev \
  libopenh264-dev \
  zlib1g-dev \
  libssl-dev \
  libdbus-1-dev \
  libxcomposite-dev \
  libxdamage-dev \
  libxrandr-dev \
  libxtst-dev \
  libasound2-dev \
  libxkbfile-dev \
  # Should be Java 21
  default-jdk \
  doxygen \
  libantlr4-runtime-dev \
  graphviz \
  vim \
  && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------------------------------------
# Install dezyne
USER root

COPY scripts/install_dezyne.sh /home/${USERNAME}/install_dezyne.sh

RUN chown ${USERNAME}:${USERNAME} /home/${USERNAME}/install_dezyne.sh && \
    chmod +x /home/${USERNAME}/install_dezyne.sh && \
    sed -i 's/\r$//' /home/${USERNAME}/install_dezyne.sh

# now switch to normal user (IMPORTANT)
USER ${USERNAME}
WORKDIR ${HOME}

# run installer as NON-root (required by Dezyne)
RUN bash /home/${USERNAME}/install_dezyne.sh

# -----------------------------------------------------------------------------------------------------------
# Install gf2 for debugging
RUN git clone https://github.com/nakst/gf.git
WORKDIR ${HOME}/gf
RUN ./build.sh

# -----------------------------------------------------------------------------------------------------------
# Install KODA
USER ${USERNAME}
WORKDIR ${HOME}
RUN wget https://update.rascal-mpl.org/console/rascal-0.40.9.jar -O rascal-0.40.9.jar
# Rascal can now be used with:
# java -jar ~/rascal-0.40.9.jar Main.rsc <input>  <output>

RUN git clone https://github.com/FelipeACXavier/KODA.git

# -----------------------------------------------------------------------------------------------------------
# Install emscripten so we are able to build the wasm version
RUN git clone https://github.com/emscripten-core/emsdk.git
WORKDIR ${HOME}/emsdk

RUN ./emsdk install 3.1.56
RUN ./emsdk activate 3.1.56
RUN bash -c "source ${HOME}/emsdk/emsdk_env.sh && embuilder build zlib"

# -----------------------------------------------------------------------------------------------------------
# Make the shell look a bit nicer
RUN echo "function custom_prompt() {" >> /home/${USERNAME}/.bashrc \
 && echo "  PS1='\\[\\e[32m\\]\\u@\\h\\[\\e[00m\\]:\\[\\e[34m\\]\\w \\[\\e[93m\\][docker:maki]\\[\\e[00m\\]\\n> '" >> /home/${USERNAME}/.bashrc \
 && echo "}" >> /home/${USERNAME}/.bashrc \
 && echo "PROMPT_DIRTRIM=2" >> /home/${USERNAME}/.bashrc \
 && echo "PROMPT_COMMAND=\"custom_prompt\"" >> /home/${USERNAME}/.bashrc

RUN echo "EMSDK_QUIET=1 source ${HOME}/emsdk/emsdk_env.sh" >> /home/${USERNAME}/.bashrc
# -----------------------------------------------------------------------------------------------------------
# Cd to the maki directory and end
WORKDIR ${HOME}/maki
CMD ["bash"]
